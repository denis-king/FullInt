{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "FULLINT_BUILD_BENCH": "ON",
        "VCPKG_MANIFEST_FEATURES": "gmp"
      }
    },
    {
      "name": "x64",
      "displayName": "Windows x64",
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "x86",
      "displayName": "Windows x86",
      "inherits": "base",
      "architecture": { "value": "x86", "strategy": "external" }
    },
    {
      "name": "x64-bench",
      "displayName": "Windows x64 + GMP benchmarks",
      "inherits": [ "x64", "vcpkg" ],
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static-md" }
    },
    {
      "name": "x86-bench",
      "displayName": "Windows x86 + GMP benchmarks",
      "inherits": [ "x86", "vcpkg" ],
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x86-windows-static-md" }
    }
  ],
  "buildPresets": [
    { "name": "x64", "configurePreset": "x64" },
    { "name": "x86", "configurePreset": "x86" },
    { "name": "x64-bench", "configurePreset": "x64-bench" },
    { "name": "x86-bench", "configurePreset": "x86-bench" }
  ]
}
