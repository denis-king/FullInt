<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0: the widest reach (.NET Framework 4.6.1+, Xamarin, Mono, Unity, .NET Core 2+);
         net8.0: the same code plus what newer runtimes allow (SuppressGCTransition on short native calls) -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- the project folder keeps its name; the assembly and the package are FullInt, the
         namespace FullNumerics -->
    <AssemblyName>FullInt</AssemblyName>
    <RootNamespace>FullNumerics</RootNamespace>
  </PropertyGroup>

  <!-- the NuGet package (pack/pack-nuget.ps1 builds the native libraries of every platform and
       packs them; a plain `dotnet pack` without them stops with FULLINT002) -->
  <PropertyGroup>
    <PackageId>FullInt</PackageId>
    <Version>1.0.0-preview.1</Version>
    <Authors>Denys Omelianenko</Authors>
    <Description>Fast arbitrary-precision integers for .NET: an alternative to System.Numerics.BigInteger with the same API (operators, Parse / ToString, bytes, generic math). Hand-written assembly kernels (x64, x86, ARM64) and sub-quadratic algorithms make it faster than BigInteger at every size (on ARM64 on par at a few words): 1.5-5x on numbers of a few words, 10-100x on large ones (against .NET 10; multiplication, division, decimal conversion). The same kernels in the C++ version run on par with GMP. No native dependencies to install; a managed core runs on every other platform.</Description>
    <PackageTags>bigint;biginteger;arbitrary-precision;bignum;integer;math;numerics;assembly;simd</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/denis-king/FullInt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/denis-king/FullInt</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Denys Omelianenko</Copyright>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- not every public member has an XML comment yet -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- the native libraries to pack: <dir>/<rid>/<file> -->
    <FullIntNativePackDir Condition="'$(FullIntNativePackDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'out', 'native'))</FullIntNativePackDir>
  </PropertyGroup>

  <!-- Span, MemoryMarshal, ArrayPool for netstandard2.0 (built into net8.0) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.1.1" />
  </ItemGroup>

  <!-- builds the native library of this machine for the tests and the benchmarks; not a package
       dependency (the package carries the libraries in runtimes/) -->
  <ItemGroup>
    <ProjectReference Include="..\FullInt.AsmForNet\FullInt.AsmForNet.csproj" PrivateAssets="all" />
  </ItemGroup>

  <!-- the public surface is FullInt (and WordOrder, FullIntJsonConverter); the engine, the cores and
       the algorithms are internal, open to the tests and the benchmarks -->
  <ItemGroup>
    <InternalsVisibleTo Include="FullInt.Tests" />
    <InternalsVisibleTo Include="FullInt.Benchmarks" />
  </ItemGroup>

  <!-- ===================== package content ===================== -->
  <ItemGroup>
    <FullIntNativeAsset Include="$(FullIntNativePackDir)win-x64\FullIntOperations_win_x64.dll" Rid="win-x64" />
    <FullIntNativeAsset Include="$(FullIntNativePackDir)win-x86\FullIntOperations_win_x86.dll" Rid="win-x86" />
    <FullIntNativeAsset Include="$(FullIntNativePackDir)linux-x64\libFullIntOperations_linux_x64.so" Rid="linux-x64" />
    <FullIntNativeAsset Include="$(FullIntNativePackDir)linux-arm64\libFullIntOperations_linux_arm64.so" Rid="linux-arm64" />
    <FullIntNativeAsset Include="$(FullIntNativePackDir)linux-arm\libFullIntOperations_linux_arm.so" Rid="linux-arm" />

    <None Include="@(FullIntNativeAsset)" Pack="true" PackagePath="runtimes/%(Rid)/native/" Visible="false" />
    <None Include="..\pack\README.md" Pack="true" PackagePath="/" Visible="false" />
    <!-- .NET Framework reads no runtimes/ folder: these copy the Windows libraries next to the app -->
    <None Include="..\pack\FullInt.targets" Pack="true" PackagePath="build/;buildTransitive/" Visible="false" />
  </ItemGroup>

  <Target Name="FullIntCheckNativeForPack" BeforeTargets="GenerateNuspec">
    <Error Code="FULLINT002"
           Condition="!Exists('%(FullIntNativeAsset.Identity)')"
           Text="FullInt: the native library %(FullIntNativeAsset.Identity) is missing; build the package with pack/pack-nuget.ps1 (it builds the libraries of every platform)." />
  </Target>

</Project>
