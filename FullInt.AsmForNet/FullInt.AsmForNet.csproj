<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds the native assembly kernels (FullInt.Asm) for the target platform and flows
    the resulting library to every project that references this one (directly or transitively).

    Target platform = $(RuntimeIdentifier) if set, otherwise the build host.
    Only RIDs listed in FullIntNativeSupportedRids are built; others get a warning and
    the library runs on the managed fallback core.

    Overrides (env or /p:):
      FULLINT_NASM / FULLINT_LINK   tool paths for build-native.cmd
      FullIntNativeRid=<rid>        build for a specific RID
      FullIntSkipNative=true        do not build or copy native code
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <!-- this project has no C# sources -->
    <NoWarn>$(NoWarn);CS2008</NoWarn>
  </PropertyGroup>

  <!-- ===================== target platform ===================== -->
  <PropertyGroup>
    <FullIntNativeSupportedRids>win-x64;win-x86;linux-x64</FullIntNativeSupportedRids>

    <FullIntNativeRid Condition="'$(FullIntNativeRid)' == ''">$(RuntimeIdentifier)</FullIntNativeRid>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FullIntNativeRid)' == ''">
    <_FullIntHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</_FullIntHostOS>
    <_FullIntHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_FullIntHostOS>
    <_FullIntHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_FullIntHostOS>
    <_FullIntHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_FullIntHostArch>
    <_FullIntHostArch>$(_FullIntHostArch.ToLowerInvariant())</_FullIntHostArch>
    <FullIntNativeRid>$(_FullIntHostOS)-$(_FullIntHostArch)</FullIntNativeRid>
  </PropertyGroup>

  <PropertyGroup>
    <!-- os = first RID segment, arch = last (handles e.g. linux-musl-x64) -->
    <FullIntNativeOS>$(FullIntNativeRid.Substring(0, $(FullIntNativeRid.IndexOf('-'))))</FullIntNativeOS>
    <FullIntNativeArch>$(FullIntNativeRid.Substring($([MSBuild]::Add($(FullIntNativeRid.LastIndexOf('-')), 1))))</FullIntNativeArch>

    <FullIntNativeSupported>false</FullIntNativeSupported>
    <FullIntNativeSupported Condition="'$(FullIntSkipNative)' != 'true' and $([System.String]::Copy(';$(FullIntNativeSupportedRids);').Contains(';$(FullIntNativeRid);'))">true</FullIntNativeSupported>

    <FullIntAsmDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'FullInt.Asm'))</FullIntAsmDir>
    <FullIntNativeObjDir>$([MSBuild]::NormalizeDirectory('$(FullIntAsmDir)', 'obj', '$(FullIntNativeRid)', '$(Configuration)'))</FullIntNativeObjDir>
    <FullIntNativeBinDir>$([MSBuild]::NormalizeDirectory('$(FullIntAsmDir)', 'bin', '$(FullIntNativeRid)', '$(Configuration)'))</FullIntNativeBinDir>

    <FullIntNativeLibBase>FullIntOperations_$(FullIntNativeOS)_$(FullIntNativeArch)</FullIntNativeLibBase>
    <FullIntNativeLibFile Condition="'$(FullIntNativeOS)' == 'win'">$(FullIntNativeLibBase).dll</FullIntNativeLibFile>
    <FullIntNativeLibFile Condition="'$(FullIntNativeOS)' == 'linux'">lib$(FullIntNativeLibBase).so</FullIntNativeLibFile>
    <FullIntNativeLibFile Condition="'$(FullIntNativeOS)' == 'osx'">lib$(FullIntNativeLibBase).dylib</FullIntNativeLibFile>
    <FullIntNativeLibPath>$(FullIntNativeBinDir)$(FullIntNativeLibFile)</FullIntNativeLibPath>
    <FullIntNativePdbPath>$(FullIntNativeBinDir)$(FullIntNativeLibBase).pdb</FullIntNativePdbPath>
  </PropertyGroup>

  <!-- A Windows x64 build also builds the 32-bit library: an AnyCPU app may run as a 32-bit
       process (x86 machine, or "Prefer 32-bit"), and the core factory then loads the x86 one. -->
  <PropertyGroup>
    <FullIntBuildX86Companion Condition="'$(FullIntNativeSupported)' == 'true' and '$(FullIntNativeRid)' == 'win-x64' and '$(OS)' == 'Windows_NT'">true</FullIntBuildX86Companion>
    <FullIntX86ObjDir>$([MSBuild]::NormalizeDirectory('$(FullIntAsmDir)', 'obj', 'win-x86', '$(Configuration)'))</FullIntX86ObjDir>
    <FullIntX86BinDir>$([MSBuild]::NormalizeDirectory('$(FullIntAsmDir)', 'bin', 'win-x86', '$(Configuration)'))</FullIntX86BinDir>
    <FullIntX86LibPath>$(FullIntX86BinDir)FullIntOperations_win_x86.dll</FullIntX86LibPath>
  </PropertyGroup>

  <!-- ===================== build ===================== -->
  <ItemGroup>
    <FullIntNativeInput Include="$(FullIntAsmDir)Sources\**\*.asm;$(FullIntAsmDir)Sources\**\*.inc;$(FullIntAsmDir)Sources\**\*.S" />
    <FullIntNativeInput Include="$(FullIntAsmDir)exports.def;$(FullIntAsmDir)build\*" />
  </ItemGroup>

  <Target Name="FullIntBuildNative"
          BeforeTargets="BeforeBuild"
          Condition="'$(FullIntNativeSupported)' == 'true'"
          Inputs="@(FullIntNativeInput);$(MSBuildThisFileFullPath)"
          Outputs="$(FullIntNativeLibPath)">
    <Exec Condition="'$(OS)' == 'Windows_NT'"
          Command="call &quot;$(FullIntAsmDir)build\build-native.cmd&quot; $(Configuration) $(FullIntNativeArch) &quot;$(FullIntNativeObjDir.TrimEnd('\'))&quot; &quot;$(FullIntNativeBinDir.TrimEnd('\'))&quot;"
          CustomErrorRegularExpression="(: error|^build-native: error)" />
    <Exec Condition="'$(OS)' != 'Windows_NT'"
          Command="bash &quot;$(FullIntAsmDir)build/build-native.sh&quot; $(Configuration) $(FullIntNativeOS) $(FullIntNativeArch) &quot;$(FullIntNativeObjDir)&quot; &quot;$(FullIntNativeBinDir)&quot;" />
  </Target>

  <Target Name="FullIntBuildNativeX86Companion"
          BeforeTargets="BeforeBuild"
          Condition="'$(FullIntBuildX86Companion)' == 'true'"
          Inputs="@(FullIntNativeInput);$(FullIntAsmDir)exports_x86.def;$(MSBuildThisFileFullPath)"
          Outputs="$(FullIntX86LibPath)">
    <Exec Command="call &quot;$(FullIntAsmDir)build\build-native.cmd&quot; $(Configuration) x86 &quot;$(FullIntX86ObjDir.TrimEnd('\'))&quot; &quot;$(FullIntX86BinDir.TrimEnd('\'))&quot;"
          CustomErrorRegularExpression="(: error|^build-native: error)" />
  </Target>

  <Target Name="FullIntNativeNotSupported"
          BeforeTargets="BeforeBuild"
          Condition="'$(FullIntNativeSupported)' != 'true' and '$(FullIntSkipNative)' != 'true'">
    <Warning Code="FULLINT001"
             Text="FullInt: no native backend for '$(FullIntNativeRid)' yet (supported: $(FullIntNativeSupportedRids)). The managed fallback core will be used." />
  </Target>

  <!-- ===================== flow to consumers ===================== -->
  <ItemGroup Condition="'$(FullIntBuildX86Companion)' == 'true'">
    <None Include="$(FullIntX86LibPath)"
          Link="FullIntOperations_win_x86.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="$(FullIntX86BinDir)FullIntOperations_win_x86.pdb"
          Condition="'$(Configuration)' == 'Debug'"
          Link="FullIntOperations_win_x86.pdb"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(FullIntNativeSupported)' == 'true'">
    <None Include="$(FullIntNativeLibPath)"
          Link="$(FullIntNativeLibFile)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
    <None Include="$(FullIntNativePdbPath)"
          Condition="'$(Configuration)' == 'Debug' and '$(FullIntNativeOS)' == 'win'"
          Link="$(FullIntNativeLibBase).pdb"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
