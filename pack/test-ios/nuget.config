<?xml version="1.0" encoding="utf-8"?>
<!-- the package from out/nuget, its dependencies from nuget.org; a packages folder of its own, so a
     rebuilt package of the same version is never taken from the global cache -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="../../out/pkgtest/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="../../out/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
